################################################################################
# Terminal
################################################################################

cask "ghostty"                                  # GPU-accelerated terminal emulator with native UI
cask "font-jetbrains-mono-nerd-font"            # Patched font supplying the prompt glyphs
brew "tmux"                                     # Terminal multiplexer, for detachable and remote sessions

# Shell
brew "oh-my-posh"                               # Prompt theme engine for any shell
brew "zsh-autosuggestions"                      # Suggests commands inline from history as you type
brew "zsh-fast-syntax-highlighting"             # Colours commands by validity as you type
brew "zsh-completions"                          # Additional completion definitions

################################################################################
# Utilities
################################################################################

cask "1password-cli"                            # 1Password CLI, invoked as `op`
brew "bat"                                      # Newer `cat` utility
cask "beyond-compare"                           # Compare files and folders
brew "difftastic"                               # Git diff that understands syntax
brew "dust"                                     # More intuitive version of du in rust
brew "eza"                                      # Newer `ls` utility
brew "fd"                                       # Newer `find` utility
brew "fzf"                                      # Fuzzy finder; pairs with fd and ripgrep
brew "gnu-sed"                                  # GNU sed as `gsed`; required by the `sed` alias in .zshrc
brew "gnupg"                                    # GNU Pretty Good Privacy (PGP) package
brew "gping"                                    # Ping, but with a graph
brew "jq"                                       # Lightweight and flexible command-line JSON processor
brew "ncdu"                                     # NCurses Disk Usage
brew "parallel"                                 # Shell command parallelization utility
brew "procs"                                    # Modern replacement for ps written by Rust
brew "ripgrep"                                  # Newer `grep` utility; required by the `grep` alias and .ripgreprc
brew "stow"                                     # A symlink farm manager, used for git versioned dotfiles
brew "tealdeer"                                 # Simplified community-driven man pages; provides `tldr`
brew "tree"                                     # Display directories as trees (with optional color/HTML output)
brew "wget"                                     # Internet file retriever
brew "yq"                                       # Like jq, but for YAML
brew "zoxide"                                   # Smarter `cd` that learns your most-used directories

################################################################################
# Languages
################################################################################

brew "go"                                       # Go compiler and toolchain
brew "node"                                     # JavaScript runtime, ships with npm
brew "sbt"                                      # Build tool for Scala projects
brew "scala-cli"                                # A command-line tool to interact with the Scala language
cask "temurin@25"                               # Current LTS JDK
brew "uv"                                       # Fast installer and resolver; replaces pip/venv/poetry/pyenv

################################################################################
# Development
################################################################################

# IDE
cask "jetbrains-toolbox", args: { adopt: true } # Installs and updates the JetBrains IDEs

# AI-assisted development
cask "claude-code"                              # Anthropic's agent CLI, invoked as `claude`
cask "codex"                                    # OpenAI's agent CLI, invoked as `codex`
brew "openspec"                                 # Spec-driven development workflow for both agent CLIs

# Version control
brew "git"                                      # Distributed revision control system
brew "git-delta"                                # Syntax-highlighting pager for git diffs
brew "gh"                                       # GitHub command-line tool
brew "tig"                                      # Text interface for Git repositories

# AWS
brew "awscli"                                   # Official Amazon AWS command-line interface

# Terraform
brew "terragrunt"                               # Thin wrapper for Terraform e.g. for locking state
brew "tfenv", link: true                        # Terraform version manager inspired by rbenv

# Containers
# brew "colima"                                 # Container runtime; needs docker or podman as a client
# brew "docker"                                 # Docker CLI client for the colima runtime

# Kubernetes
brew "kubernetes-cli"                           # kubectl, the Kubernetes CLI
brew "k9s"                                      # Terminal UI for managing clusters
brew "kubectx"                                  # Fast context and namespace switching
brew "stern"                                    # Multi-pod log tailing
brew "helm"                                     # Kubernetes package manager
brew "kustomize"                                # Template-free configuration customization
brew "kubeconform"                              # Fast manifest schema validation
brew "kind"                                     # Local clusters running in Docker

# Linters
brew "pre-commit"                               # Framework for managing pre-commit hooks
brew "shellcheck"                               # Static analysis and lint tool, for (ba)sh scripts
brew "trivy"                                    # Security scanner for IaC, containers and dependencies
brew "yamllint"                                 # Linter for YAML files
